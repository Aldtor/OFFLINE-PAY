<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application>

        <!--
          Auto-drives the *99# USSD menus so the user only enters their UPI PIN.
          Protected by BIND_ACCESSIBILITY_SERVICE (only the system can bind it); dormant
          unless an OfflinePay payment session is armed. Never reads or enters the PIN.
        -->
        <service
            android:name="com.offlinepay.feature.ussd.autodrive.UssdAccessibilityService"
            android:exported="true"
            android:label="@string/ussd_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ussd_accessibility_config" />
        </service>

    </application>
</manifest>
