<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme — OfflinePayTheme Compose wraps MaterialTheme; this is required for Window/Activity -->
    <style name="Theme.OfflinePay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen theme (Android 12+) -->
    <style name="Theme.OfflinePay.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#2563EB</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.OfflinePay</item>
    </style>
</resources>
